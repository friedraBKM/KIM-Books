# Kopiervorlage für lokale Tests: als .env speichern und `node --env-file=.env src/server.js`
# In Coolify trägst du diese Werte unter "Environment Variables" ein.

# Pflicht
ADMIN_PASSWORD=ein-langes-passwort
APP_SECRET=hier-eine-lange-zufallszeichenkette
ACCESS_CODE=masterclass2026

# Buchsuche (ohne Key wird Open Library verwendet)
GOOGLE_BOOKS_API_KEY=
OPENLIBRARY_CONTACT=deine@mail.de

# KI-Abgleich
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Benachrichtigung bei manuellen Einträgen (optional, E-Mail und/oder Webhook)
NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_WEBHOOK_URL=

# Sonstiges
PUBLIC_URL=https://buecher.example.de
PRIVACY_CONTACT=Vorname Nachname, mail@example.de
